---
import type { Product } from '../data/products';
import { local, site, storeUrl } from '../data/site';
interface Props { product: Product; medium: 'home' | 'product_page'; }
const { product, medium } = Astro.props;
---
{product.status === 'in-development' ? (
  <a class="text-link" href={'mailto:' + site.email}>{site.email}</a>
) : product.platform === 'web' ? (
  <a class="play" href={local(product.link)}>Play in your browser</a>
) : (
  <a class="badge" href={storeUrl(product.link!, medium)} aria-label={'Get ' + product.name + ' on Google Play'}>
    <img alt="Get it on Google Play" width="646" height="250" src={local('google-play-badge.png')} />
  </a>
)}
<style>
  .badge { display: inline-flex; align-items: center; width: 11rem; flex-shrink: 0; }
  .play { display: inline-flex; align-items: center; min-height: 44px; padding: .7rem 1.2rem; border-radius: 3px;
    background: var(--ink); color: var(--paper); font-weight: 600; font-size: .9375rem; text-decoration: none; }
  .play:hover { text-decoration: underline; text-decoration-color: var(--ember); }
</style>
