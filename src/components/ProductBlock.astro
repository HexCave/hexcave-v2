---
import type { Product } from '../data/products';
import { statusLabel } from '../data/products';
import { local } from '../data/site';
import ProductImage from './ProductImage.astro';
import StoreButton from './StoreButton.astro';
interface Props { product: Product; index: number; }
const { product: p, index } = Astro.props;
---
<article class:list={['block', { reverse: index % 2 === 1, landscape: p.platform === 'web', upcoming: !p.screenshots.length }]}>
  <div class="plates">
    {p.homeShots.map((i) => <div class="plate">
      <ProductImage shot={p.screenshots[i]} eager={index === 0}
        sizes={p.platform === 'web' ? '(min-width: 960px) 30vw, 76vw' : '(min-width: 1200px) 220px, (min-width: 960px) 17vw, 36vw'} />
    </div>)}
    {!p.screenshots.length && p.icon && <img class="solo-icon" src={typeof p.icon.src === 'string' ? p.icon.src : p.icon.src.src} width="144" height="144" loading="lazy" alt={p.name + ' app icon'} />}
  </div>
  <div class="copy">
    <p class="meta">{statusLabel(p)}</p>
    <h2>{p.name}</h2>
    <p>{p.oneLine}</p>
    <div class="actions">
      <a class="text-link" href={local(p.slug + '/')}>See {p.name}&nbsp; →</a>
      <StoreButton product={p} medium="home" />
    </div>
  </div>
</article>
<style>
  .block { border-top: 1px solid var(--rule); padding-block: var(--section); display: grid; gap: 2rem; }
  .plates { display: flex; align-items: flex-start; gap: clamp(.5rem, 1.1vw, 1rem); }
  .plate { flex: 1 1 0; min-width: 0; }
  .plate:nth-child(2) { margin-top: clamp(1rem, 3vw, 3rem); }
  .plate:nth-child(3) { margin-top: clamp(2rem, 6vw, 6rem); }
  .plate :global(img) { width: 100%; border: 1px solid var(--rule); border-radius: 20px; }
  .copy { align-self: center; }
  .copy h2 { margin: .5rem 0 .85rem; font-size: clamp(3.2rem, 6.4vw, 5.6rem); }
  .copy > p:not(.meta) { max-width: 34ch; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: .3rem 1.25rem; margin-top: 1.5rem; }
  .actions:has(:global(.badge)) { flex-direction: column; align-items: flex-start; }
  .reverse .plates:not(:has(.solo-icon)) { max-width: 34rem; }
  .landscape .plates { display: grid; grid-template-columns: repeat(8, 1fr); gap: 0; }
  .landscape .plate:first-child { grid-column: 1/7; }
  .landscape .plate:nth-child(2) { grid-column: 3/-1; margin-top: -1.5rem; }
  .solo-icon { border-radius: 20px; width: clamp(6rem, 12vw, 10rem); }
  @media (min-width: 960px) {
    .block { grid-template-columns: var(--columns); align-items: center; column-gap: 1.5rem; }
    .copy { grid-column: 1/6; grid-row: 1; }
    .plates { grid-column: 6/-1; grid-row: 1; }
    .reverse .plates { grid-column: 1/7; }
    .reverse .copy { grid-column: 8/-1; }
    .upcoming .plates { justify-content: center; }
  }
</style>
