---
import { principleTitles, products, type Product } from '../data/products';
import { local } from '../data/site';
interface Props { product?: Product; }
const { product } = Astro.props;
const keys = Object.keys(principleTitles) as (keyof typeof principleTitles)[];
const items = keys.flatMap((key) => {
  const examples = (product ? [product] : products).filter((p) => p.principles[key]);
  if (!examples.length) return [];
  // Each studio principle has one concrete example. Product pages give their own evidence.
  const example = !product && key === 'offline' ? examples[examples.length - 1] : examples[0];
  return [{ key, example, text: example.principles[key] }];
});
---
{items.length > 0 && <section class="principles" aria-labelledby="principles-heading">
  <h2 id="principles-heading">How we make things</h2>
  <div class="statements">
    {items.map(({ key, example, text }) => <div>
      <h3>{principleTitles[key]}</h3>
      <p>{text}</p>
      {!product && <a class="text-link" href={local(example.slug + '/')}>{example.name} →</a>}
    </div>)}
  </div>
</section>}
<style>
  section { border-top: 1px solid var(--rule); padding-block: var(--section); }
  .statements { display: grid; gap: 2rem clamp(2rem, 8vw, 8rem); margin-top: 2.5rem; }
  .statements > div { border-top: 1px solid var(--rule); padding-top: 1.2rem; }
  h3 { margin-bottom: .6rem; }
  p, a { color: var(--ink-2); }
  @media(min-width: 46rem) { .statements { grid-template-columns: 1fr 1fr; } }
</style>
