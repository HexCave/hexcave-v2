---
import Base from '../layouts/Base.astro';
import ProductBlock from '../components/ProductBlock.astro';
import Principles from '../components/Principles.astro';
import { products } from '../data/products';
import { site, local } from '../data/site';
const lastLine = 'product and game studio.';
---
<Base title="Hexcave — Independent product and game studio" description={site.line + ' ' + products.map((p) => p.name).join(', ') + '.'} path="">
  <div class="wrap">
    <section class="hero" aria-labelledby="studio">
      <h1 id="studio">{site.line.slice(0, -lastLine.length)}<em>{lastLine}</em></h1>
      <div class="intro">
        <img src={local('favicon.svg')} alt="" width="40" height="40" />
        <p>{site.introduction}</p>
      </div>
    </section>
    <section id="products" aria-label="Products">
      {products.map((product, index) => <ProductBlock {product} {index} />)}
    </section>
    <Principles />
  </div>
</Base>
<style>
  .hero { padding-block: clamp(3rem, 6vw, 6rem); display: grid; align-items: end; gap: 1.75rem; }
  h1 { max-width: 18ch; }
  h1 em { display: block; }
  .intro { color: var(--ink-2); max-width: 30ch; }
  .intro img { margin-bottom: 1rem; }
  @media(min-width: 960px) {
    .hero { grid-template-columns: var(--columns); gap: 1.5rem; }
    h1 { grid-column: 1/10; max-width: none; font-size: clamp(3.5rem, 6.5vw, 5.85rem); }
    .intro { grid-column: 10/-1; padding-bottom: .3rem; }
  }
  @media(max-width: 959px) {
    .intro { max-width: 38ch; }
    .intro img { display: none; }
  }
</style>
